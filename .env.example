# Anyigba - Variables d'environnement
PORT=3000
NODE_ENV=development

# Base de données
DB_DRIVER=pg
DATABASE_URL=postgres://dev:dev@localhost:5432/anyigba
DATABASE_URL_UNPOOLED=postgres://dev:dev@localhost:5432/anyigba

# Sécurité & Empreintes
